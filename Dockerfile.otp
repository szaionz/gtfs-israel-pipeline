FROM ghcr.io/szaionz/gtfs-israel-pipeline as pipeline


FROM debian:trixie as downloader
RUN apt-get update && apt-get install -y curl && \
curl -Lo /region.osm.pbf https://download.geofabrik.de/asia/israel-and-palestine-latest.osm.pbf


FROM opentripplanner/opentripplanner:2.8.1
COPY --from=pipeline /out/gtfs.zip /var/opentripplanner/gtfs.zip
COPY --from=downloader /region.osm.pbf /var/opentripplanner/region.osm.pbf

RUN /docker-entrypoint.sh --build --save
ENTRYPOINT [ "/docker-entrypoint.sh", "--load", "--serve" ]
